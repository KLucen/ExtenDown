{
  "name": "markdown-editor-tauri-kit",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Reusable Markdown reader and source editor extracted from MerMarkd",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
