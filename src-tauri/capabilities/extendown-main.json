{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "extendown-main",
  "description": "ExtenDown main window document commands and window creation are registered by the Rust host.",
  "windows": ["main", "document-*"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "allow-current-document",
    "allow-new-markdown",
    "allow-new-document-window",
    "allow-open-markdown",
    "allow-recent-markdown",
    "allow-open-recent-markdown",
    "allow-save-markdown",
    "allow-save-markdown-as",
    "allow-reload-markdown",
    "allow-write-markdown-draft",
    "allow-clear-markdown-draft",
    "allow-recover-markdown-drafts",
    "allow-restore-markdown-draft",
    "allow-discard-markdown-draft",
    "allow-read-document-image",
    "allow-open-plugin-package",
    "allow-set-default-markdown-app",
    "allow-save-export",
    "allow-installed-components",
    "allow-install-official-component",
    "allow-choose-workspace",
    "allow-close-workspace",
    "allow-workspace-list",
    "allow-workspace-open",
    "allow-workspace-current-file",
    "allow-workspace-initial-location",
    "allow-workspace-create",
    "allow-workspace-rename",
    "allow-workspace-trash",
    "allow-workspace-reveal",
    "allow-workspace-search",
    "allow-workspace-check-links"
  ]
}
